# Runs the queue-polling video pipeline worker (worker/index.ts) as a
# long-running container — deploy this separately from the Next.js web app
# (which goes to Vercel) to Railway, Fly.io, Render, or any other Docker
# host. See docs/ARCHITECTURE.md for why these are two separate deployments.
FROM node:22-slim

# Real ffmpeg from Debian's package repo — no whisper filter needed here,
# since production transcription goes through a hosted API instead
# (TRANSCRIPTION_PROVIDER=hosted-api, see lib/video/transcribe.ts).
# fonts-noto-core covers Arabic/Urdu and Devanagari/Hindi glyphs for burned-
# in captions (see lib/video/caption.ts) — a bare Debian image ships no
# fonts at all, so without this ANY caption text would fail to render.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fonts-noto-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm install --no-save tsx

COPY lib ./lib
COPY worker ./worker
COPY tsconfig.json ./
# The watermark logo (see lib/video/paths.ts's WATERMARK_LOGO_PATH) — every
# rendered clip is branded with it automatically, so the worker needs its
# own copy rather than fetching one per job.
COPY public/watermark.png ./public/watermark.png

ENV TRANSCRIPTION_PROVIDER=hosted-api
ENV NODE_ENV=production

CMD ["npx", "tsx", "worker/index.ts"]

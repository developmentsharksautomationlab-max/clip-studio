# --- Local dev ---
# None of these are required to run `npm run dev`. With nothing set below,
# Clip Studio runs exactly as it always has: local JSON job files under
# storage/jobs, local disk output under public/generated, and transcription
# via ffmpeg's built-in whisper filter (requires an ffmpeg build compiled
# with --enable-whisper, e.g. the gyan.dev "full" Windows builds).

# --- AI chatbot + hosted transcription (Groq, free tier) ---
# Get a free key at https://console.groq.com (API Keys -> Create API Key).
# Powers both the in-app chatbot (app/api/chat) and, when
# TRANSCRIPTION_PROVIDER=hosted-api, transcription in the worker.
GROQ_API_KEY=

# Optional overrides — defaults already point at Groq.
# GROQ_API_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
# TRANSCRIPTION_API_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# "ffmpeg-filter" (default, local dev) or "hosted-api" (production/worker).
# TRANSCRIPTION_PROVIDER=ffmpeg-filter

# --- Production: database (Neon Postgres recommended) ---
# Set on both the Vercel web app and the worker — they share one database.
# When unset, job state falls back to local JSON files (see above).
# POSTGRES_URL=

# --- Production: file storage (Vercel Blob) ---
# Create a Blob store in the Vercel dashboard; it fills this in for you when
# linked to the project. Set on both the Vercel web app and the worker.
# When unset, uploads/outputs fall back to local disk (see above). The
# upload form checks this live via /api/config and switches to direct-to-
# blob uploads automatically once it's set — no separate flag or rebuild
# needed, and no NEXT_PUBLIC_ variable to keep in sync with this one.
# BLOB_READ_WRITE_TOKEN=

# --- Worker only ---
# Set automatically inside Dockerfile.worker; listed here for reference.
# TRANSCRIPTION_PROVIDER=hosted-api
